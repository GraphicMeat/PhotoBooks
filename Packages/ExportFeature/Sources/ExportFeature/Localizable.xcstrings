    "Found a bug? Tell us what happened and how to reproduce it so we can investigate." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Fehler gefunden? Beschreibe, was passiert ist und wie man ihn nachstellt, damit wir ihn untersuchen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Found a bug? Tell us what happened and how to reproduce it so we can investigate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has encontrado un error? Cuéntanos qué pasó y cómo reproducirlo para que podamos investigarlo."
          }
        },
