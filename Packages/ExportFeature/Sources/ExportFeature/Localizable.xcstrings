    "After donating, you’ll come back here and the sponsor pages will be gone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Spende kommst du hierher zurück und die Sponsorenseiten sind weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After donating, you’ll come back here and the sponsor pages will be gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de donar, volverás aquí y las páginas de patrocinio habrán desaparecido."
