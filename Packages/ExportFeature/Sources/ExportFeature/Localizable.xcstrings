    "Printed a book for a public or commercial project? Share only work you have permission to make public. Keep family albums and private photos private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Buch für ein öffentliches oder kommerzielles Projekt gedruckt? Teile nur Arbeiten, die du veröffentlichen darfst. Familienalben und private Fotos bleiben privat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Printed a book for a public or commercial project? Share only work you have permission to make public. Keep family albums and private photos private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has impreso un libro para un proyecto público o comercial? Comparte solo trabajos que tengas permiso para publicar. Los álbumes familiares y las fotos privadas, mejor en privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez imprimé un livre pour un projet public ou commercial ? Ne partagez que ce que vous avez le droit de rendre public. Gardez les albums de famille et les photos privées pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai stampato un libro per un progetto pubblico o commerciale? Condividi solo lavori che puoi rendere pubblici. Album di famiglia e foto private restano privati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開・商用プロジェクトのためにブックを印刷しましたか？公開の許可がある作品だけを共有してください。家族のアルバムや個人的な写真は非公開のままに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 또는 상업 프로젝트용 책을 인쇄했나요? 공개해도 되는 작업만 공유하세요. 가족 앨범과 개인 사진은 비공개로 두세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimiu um livro para um projeto público ou comercial? Compartilhe só trabalhos que você tem permissão para divulgar. Álbuns de família e fotos pessoais devem continuar privados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为公开或商业项目印刷了照片书？请只分享你有权公开的作品。家庭相册和私人照片请保持私密。"
          }
        }
      }
    },
